# Copy to .env and fill in. NEVER commit .env (it holds your VPN key).

# Run containers as this user, so downloaded files belong to you (`id -u`, `id -g`)
PUID=1000
PGID=1000
TZ=Etc/UTC
GREG_WEB_USER=greg

# ---------------------------------------------------------------------------
# VPN, option A: your own WireGuard server/peer (the "custom" provider)
#
# From a normal wg-quick config:
#   [Interface] PrivateKey  -> WIREGUARD_PRIVATE_KEY
#   [Interface] Address     -> WIREGUARD_ADDRESSES   (IPv4 is enough)
#   [Peer] PublicKey        -> WIREGUARD_PUBLIC_KEY
#   [Peer] PresharedKey     -> WIREGUARD_PRESHARED_KEY  (if you have one)
#   [Peer] Endpoint host    -> WIREGUARD_ENDPOINT_IP    (an IP ADDRESS: gluetun
#                              does not resolve names here; `nslookup` it)
#   [Peer] Endpoint port    -> WIREGUARD_ENDPOINT_PORT
#
# Alternative: skip all of these and bind-mount your whole config file as
# /gluetun/wireguard/wg0.conf (add `- ./wg0.conf:/gluetun/wireguard/wg0.conf:ro`
# to gluetun's volumes). The endpoint must still be an IP address.
VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.8.0.10/32
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820

# ---------------------------------------------------------------------------
# VPN, option B: a commercial provider gluetun knows (Mullvad, Proton, PIA, ...).
# Set VPN_SERVICE_PROVIDER and the provider's variables instead; see
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Note that shared commercial exit IPs are sometimes blocked by the very sites
# you want to reach (Patreon sits behind Cloudflare). Your own exit works best.
